---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import CtaBand from '../components/CtaBand.astro';

const description =
  'How CoreStone AI works: we map the call, build and tune the voice agent against your real systems, then it goes live and the calls handle themselves — first deployment in under five weeks.';

const steps = [
  {
    title: 'We map the call.',
    body: 'We learn exactly what information you need, who gets called, and where the answers should go. This is a conversation, not a spec document — usually a single working session.',
  },
  {
    title: 'We build and tune the agent.',
    body: 'We design the conversation, connect it to your systems, and refine it until it sounds natural and reliably gets the right information.',
  },
  {
    title: 'It goes live and the calls handle themselves.',
    body: 'The agent starts making calls on your schedule. Answers flow straight into your tools in real time. You get your team’s hours back.',
  },
];

const faqs = [
  {
    q: 'Do we need to already use Smartsheet, or a specific tool?',
    a: 'No. We connect to whatever you already use to track this — a spreadsheet, Smartsheet, Monday, your CRM, or even just email or Slack. The agent adapts to your systems, not the other way around.',
  },
  {
    q: 'Does this only work in English?',
    a: 'No — the underlying voice technology supports multiple languages. We configure the agent for whichever language your team and the people you’re calling actually speak.',
  },
  {
    q: 'What if we don’t have clean data or a process set up yet?',
    a: 'Most clients don’t. Figuring out what to capture and where it should land is part of the first working session — you don’t need anything set up in advance.',
  },
  {
    q: 'What happens if the agent can’t reach someone, or gets an unclear answer?',
    a: 'It doesn’t guess. Unclear or incomplete calls are flagged for a quick human follow-up rather than logged as if everything went fine.',
  },
  {
    q: 'Will this disrupt how our team currently works?',
    a: 'No new software for your team to learn. The agent slots in behind the scenes — your team keeps using the same spreadsheet, schedule, or CRM they already check.',
  },
  {
    q: 'Is our data and these phone calls handled responsibly?',
    a: 'Yes. Call data and the information collected stay within your own systems — we don’t retain anything beyond what’s needed to do the job, and calls are handled with appropriate disclosure to the person on the line.',
  },
  {
    q: 'Do we have to commit to a big rollout to try this?',
    a: 'No. Engagements typically start with one specific type of call as a focused first project — not a company-wide rollout.',
  },
];
---

<BaseLayout title="Services — how it works" description={description} path="/services">
  <!-- PAGE HERO -->
  <div class="page-hero">
    <div class="container">
      <div class="page-hero__inner reveal">
        <p class="eyebrow">Services</p>
        <h1>Voice AI agents that do the calls your team shouldn’t have to</h1>
        <p class="lead">
          Most operational work isn’t complicated — it’s just constant. Someone has to call, ask,
          wait, follow up, and write it down. We automate that entire loop.
        </p>
      </div>
    </div>
  </div>

  <!-- WHAT OUR AGENTS HANDLE -->
  <Section tone="tint" aria-labelledby="handle-title">
    <p class="eyebrow">What our agents handle</p>
    <h2 id="handle-title" style="max-width: 20ch; margin-top: var(--space-5)">
      Any routine, repeatable call to collect or confirm information
    </h2>
    <div class="prose" style="margin-top: var(--space-6)">
      <p>
        Status updates, follow-ups, reminders, data gathering, simple check-ins. If your team spends
        hours a week on a certain kind of call, it’s probably a candidate.
      </p>
    </div>
    <ul class="marker-list" style="margin-top: var(--space-7)">
      <li>Status updates from field workers and crews</li>
      <li>Chasing suppliers for delivery and lead times</li>
      <li>Follow-ups on missing or incomplete information</li>
      <li>Appointment and schedule confirmations</li>
      <li>Reminders and simple check-ins</li>
      <li>Routine data gathering for your systems</li>
    </ul>
  </Section>

  <!-- THE PROCESS -->
  <Section tone="white" aria-labelledby="how-title">
    <p class="eyebrow">The process</p>
    <h2 id="how-title" style="max-width: 20ch; margin-top: var(--space-5)">Three steps, one working session to start</h2>
    <div class="steps" style="margin-top: var(--space-8)">
      {
        steps.map((step, i) => (
          <div class="step">
            <div class="step__n">{String(i + 1).padStart(2, '0')}</div>
            <div>
              <h3>{step.title}</h3>
              <p class="step__body" style="margin-top: var(--space-3)">
                {step.body}
              </p>
            </div>
          </div>
        ))
      }
    </div>

    <p class="callout" style="margin-top: var(--space-8)">
      You approve the agent before it ever makes a real call. No surprises on go-live.
    </p>
  </Section>

  <!-- WHAT YOU GET -->
  <Section tone="tint" aria-labelledby="get-title">
    <p class="eyebrow">What you get</p>
    <h2 id="get-title" style="max-width: 18ch; margin-top: var(--space-5)">
      A working agent, wired into your actual systems
    </h2>
    <div class="prose" style="margin-top: var(--space-6)">
      <p>Not a prototype, not a slide deck.</p>
    </div>
    <ul class="deliverables" style="margin-top: var(--space-7)">
      <li>
        <span>
          <strong>A configured voice agent</strong> — built, tested, and tuned for your specific call
          type before it goes live.
        </span>
      </li>
      <li>
        <span>
          <strong>Full integration with your existing systems</strong> — the spreadsheet, CRM, or
          scheduling tool you already use, no migration required.
        </span>
      </li>
      <li>
        <span>
          <strong>Call recordings and transcripts</strong> — a complete record of every conversation
          the agent has, always available to you.
        </span>
      </li>
      <li>
        <span>
          <strong>Post-launch tuning</strong> — adjustments in the weeks after go-live as real calls
          surface edge cases your process didn’t anticipate.
        </span>
      </li>
    </ul>
  </Section>

  <!-- FAQ -->
  <Section tone="white" aria-labelledby="faq-title">
    <p class="eyebrow">Questions</p>
    <h2 id="faq-title" style="max-width: 20ch; margin-top: var(--space-5)">
      Questions operations teams ask
    </h2>
    <div class="faq" style="margin-top: var(--space-8)">
      {
        faqs.map((f) => (
          <div class="faq__item">
            <h3 class="faq__q">{f.q}</h3>
            <p class="faq__a">{f.a}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <CtaBand
    tone="tint"
    eyebrow="Get started"
    heading="Let’s map your first call."
    text="Book a 20-minute call and tell us about the repetitive calls eating your team’s time. If it’s a fit, we’ll show you exactly how a voice agent would handle it."
  />
</BaseLayout>

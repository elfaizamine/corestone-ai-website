---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CALENDLY_URL, CTA_LABEL } from '../consts';
---

<BaseLayout title="Thanks" description="Your note has been received." path="/thank-you" noindex>
  <div class="page-hero">
    <div class="container">
      <div class="page-hero__inner reveal">
        <p class="eyebrow">Contact</p>
        <h1>Thanks — your note is in.</h1>
        <p class="lead">
          We read every message and will get back to you shortly. If you’d rather not wait, grab a
          time on the calendar.
        </p>
        <div class="actions">
          <a class="btn btn--lg" href={CALENDLY_URL} target="_blank" rel="noopener">{CTA_LABEL}</a>
          <a class="btn btn--ghost btn--lg" href="/">Back to home</a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

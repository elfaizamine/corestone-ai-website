---
interface Props {
  /** The headline figure, e.g. "5", "8+", "Real-time" */
  value: string;
  /** Optional unit shown small on its own line under the value, e.g. "weeks", "years" */
  unit?: string;
  label: string;
  /** Render the value at word-scale rather than numeral-scale */
  word?: boolean;
}
const { value, unit, label, word = false } = Astro.props;
---

<div class="stat">
  <div class:list={['stat__num', word && 'stat__num--word']}>
    <span class="stat__value">{value}</span>
    {unit && <span class="stat__unit">{unit}</span>}
  </div>
  <p class="stat__label">{label}</p>
</div>
